# Required for real chat. Leave unset when GRAPH_LLM_MOCK=1.
OPENROUTER_API_KEY=

# Text-to-speech. The chat UI works without this.
DEEPGRAM_API_KEY=

# Product analytics. Events are skipped when unset.
POSTHOG_API_KEY=

# Firebase Storage for POST /api/v1/storage/upload.
# The service falls back to the public client config when these are unset.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Optional Grafana Loki shipping. Console logs are always emitted.
LOKI_HOST=
LOKI_BASIC_AUTH=
# Aliases accepted by the logger:
# GRAPHANA_URL=
# GRAPHANA_USER=
# GRAPHANA_TOKEN=
LOG_LEVEL=info

# Optional OpenTelemetry export. Tracing stays off when the endpoint is unset.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_RESOURCE_ATTRIBUTES=

# Local process only. Vercel sets PORT itself.
PORT=9955

# Streams a canned chat, including a generate_image tool call, and does not
# call OpenRouter. Ignored when VERCEL_ENV=production. Never set this on the
# Production environment.
GRAPH_LLM_MOCK=
